{
  "name": "potom",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "потом. — персональный задачник для macOS и Windows",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "format": "prettier --write src tests *.ts *.json README.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests *.ts *.json README.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/golos-text": "^5.2.8",
    "@paper-design/shaders-react": "0.0.82",
    "@tauri-apps/api": "^2.10.1",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.3",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
